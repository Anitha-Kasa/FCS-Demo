,"additionalInfo":null}],"rules":[{"ruleName":"Collateral Coverage Insufficient for Loan Risk Level","definition":"{\"severity\":\"Medium\",\"ruleQuery\":\"WITH collateral_totals AS (\\r\\n    SELECT\\r\\n        LOAN_ID,\\r\\n        SUM(VALUE_USD) AS TOTAL_COLLATERAL_VALUE_USD\\r\\n    FROM COLLATERAL_SILVER\\r\\n    GROUP BY LOAN_ID\\r\\n),\\r\\nloan_risk AS (\\r\\n    SELECT\\r\\n        l.LOAN_ID,\\r\\n        l.FARMER_ID,\\r\\n        l.LOAN_AMOUNT_USD,\\r\\n        COALESCE(ct.TOTAL_COLLATERAL_VALUE_USD, 0) AS TOTAL_COLLATERAL_VALUE_USD,\\r\\n        ROUND(COALESCE(ct.TOTAL_COLLATERAL_VALUE_USD, 0) / NULLIF(l.LOAN_AMOUNT_USD, 0), 2) AS COVERAGE_RATIO,\\r\\n        UPPER(TRIM(cr.RISK_LEVEL)) AS CROP_RISK_LEVEL\\r\\n    FROM LOANS_SILVER l\\r\\n    LEFT JOIN collateral_totals ct ON l.LOAN_ID = ct.LOAN_ID\\r\\n    LEFT JOIN CROPS_SILVER cr             ON l.FARMER_ID = cr.FARMER_ID\\r\\n),\\r\\nrequired AS (\\r\\n    SELECT *,\\r\\n        CASE CROP_RISK_LEVEL\\r\\n            WHEN 'HIGH'   THEN 1.5\\r\\n            WHEN 'MEDIUM' THEN 1.0\\r\\n            ELSE 0.5\\r\\n        END AS REQUIRED_MIN_RATIO\\r\\n    FROM loan_risk\\r\\n)\\r\\nSELECT *\\r\\nFROM required\\r\\nWHERE COVERAGE_RATIO IS NULL                \\r\\n   OR COVERAGE_RATIO < REQUIRED_MIN_RATIO  \",\"active\":\"Yes\",\"threshold\":\"0\",\"schemaName\":\"DEMO_DB.PUBLIC\",\"dataQuery\":\"select count(*) from DEMO_DB.PUBLIC.LOAN_RISK_ANALYSIS\",\"dataQualityDimension\":\"Validity\",\"ruleTypeLabel\":\"SQL Query\",\"unit\":\"Percentage\",\"primaryColumn\":\"LOAN_ID\",\"recordsCount\":\"0\",\"columnNames\":\"\",\"successCriteria\":\"No bad records found\",\"ruleConditionType\":\"bad records\",\"ruleType\":\"SQLQuery\",\"percentage\":\"0\",\"name\":\"SQL query\",\"id\":\"\",\"operation\":\"<\",\"workSchemaId\":\"5613\"}","description":"Flags loans whose total collateral-to-loan-amount ratio falls below the minimum required for their crop risk tier.","ruleType":"SQLQuery","ruleOrder":0,"tableName":"LOAN_