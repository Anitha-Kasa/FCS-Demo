},{"columnName":"LOAN_STATUS","description":"","dataType":"TEXT","isNull":"Y","attributeName":null,"entityName":null,"columnOrder":10,"columnLength":"16777216","columnAlias":null,"additionalInfo":null}],"rules":[{"ruleName":"Loan Overpayment / Outstanding Amount Mismatch","definition":"{\"severity\":\"Medium\",\"ruleQuery\":\"WITH loan_totals AS (\\r\\n    SELECT\\r\\n        FARMER_ID,\\r\\n        COUNT(DISTINCT LOAN_ID)          AS TOTAL_LOANS,\\r\\n        SUM(LOAN_AMOUNT_USD)             AS TOTAL_LOAN_AMOUNT_USD\\r\\n    FROM LOANS_SILVER\\r\\n    GROUP BY FARMER_ID\\r\\n),\\r\\npayment_totals AS (\\r\\n    SELECT\\r\\n        l.FARMER_ID,\\r\\n        SUM(p.AMOUNT_PAID_USD)           AS TOTAL_AMOUNT_PAID_USD,\\r\\n        MAX(p.PAYMENT_DATE)              AS LAST_PAYMENT_DATE\\r\\n    FROM LOANS_SILVER l\\r\\n    JOIN PAYMENTS_SILVER p ON l.LOAN_ID = p.LOAN_ID\\r\\n    GROUP BY l.FARMER_ID\\r\\n),\\r\\nsummary AS (\\r\\n    SELECT\\r\\n        f.FARMER_ID,\\r\\n        f.NAME,\\r\\n        COALESCE(lt.TOTAL_LOAN_AMOUNT_USD, 0)  AS TOTAL_LOAN_AMOUNT_USD,\\r\\n        COALESCE(pt.TOTAL_AMOUNT_PAID_USD, 0)  AS TOTAL_AMOUNT_PAID_USD,\\r\\n        CASE\\r\\n            WHEN COALESCE(lt.TOTAL_LOAN_AMOUNT_USD,0) - COALESCE(pt.TOTAL_AMOUNT_PAID_USD,0) < 0 THEN 0\\r\\n            ELSE COALESCE(lt.TOTAL_LOAN_AMOUNT_USD,0) - COALESCE(pt.TOTAL_AMOUNT_PAID_USD,0)\\r\\n        END AS EXPECTED_OUTSTANDING_AMOUNT_USD\\r\\n    FROM FARMERS_SILVER f\\r\\n    LEFT JOIN loan_totals lt    ON f.FARMER_ID = lt.FARMER_ID\\r\\n    LEFT JOIN payment_totals pt ON f.FARMER_ID = pt.FARMER_ID\\r\\n)\\r\\nSELECT *\\r\\nFROM Summary\\r\\nWHERE TOTAL_AMOUNT_PAID_USD > TOTAL_LOAN_AMOUNT_USD;\",\"active\":\"Yes\",\"threshold\":\"0\",\"schemaName\":\"DEMO_DB.PUBLIC\",\"dataQuery\":\"select count(*) from DEMO_DB.PUBLIC.FARMER_FINANCIAL_SUMMARY\",\"dataQualityDimension\":\"Validity\",\"ruleTypeLabel\":\"SQL Query\",\"unit\":\"Percentage\",\"primaryColumn\":\"FARMER_ID\",\"recordsCount\":\"0\",\"col